<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      spacing="12"
      alignment="CENTER">

      <Label text="Change Password"/>

      <VBox spacing="4"
            alignment="CENTER">

            <Label text="Test password:"
                  style="-fx-text-fill: gray; -fx-font-size: 11px; -fx-font-weight: bold;"/>

            <Label text="old / new / new → new password successfully changed"
                  style="-fx-text-fill: gray; -fx-font-size: 11px;"/>

            <Label text="new password same as old password → failure"
                  style="-fx-text-fill: gray; -fx-font-size: 11px;"/>

            <Label text="new password and confirm password do not match → failure"
                  style="-fx-text-fill: gray; -fx-font-size: 11px;"/>

      </VBox>

      <PasswordField fx:id="oldPasswordField"
                     promptText="Old Password"
                     maxWidth="240"/>

      <PasswordField fx:id="newPasswordField"
                     promptText="New Password"
                     maxWidth="240"/>

      <PasswordField fx:id="confirmPasswordField"
                     promptText="Confirm New Password"
                     maxWidth="240"/>

      <Label fx:id="errorLabel"
             text=""
             maxWidth="240"
             wrapText="true"/>

      <Button text="Change Password"
              onAction="#onChangePasswordClicked"/>

</VBox>