<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <top>
        <HBox spacing="12"
              alignment="CENTER_LEFT">

            <Label text="Audit Logs"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label fx:id="logCountLabel"
                   text="0 shown"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Refresh"
                    onAction="#onRefreshClicked"/>

            <Button text="Back"
                    onAction="#onBackClicked"/>

        </HBox>
    </top>

    <left>
        <VBox spacing="10"
              prefWidth="170">

            <BorderPane.margin>
                <Insets right="16"/>
            </BorderPane.margin>

            <Label text="Filters"
                   style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

            <Label text="Username"/>

            <TextField fx:id="usernameFilterField"
                       promptText="Username"
                       maxWidth="150"/>

            <Label text="Action"/>

            <ComboBox fx:id="actionTypeFilterComboBox"
                      promptText="All actions"
                      maxWidth="150"/>

            <Label text="Result"/>

            <ComboBox fx:id="resultFilterComboBox"
                      promptText="All results"
                      maxWidth="150"/>

            <Label text="Start date"/>

            <DatePicker fx:id="startDatePicker"
                        promptText="From"
                        maxWidth="150"/>

            <Label text="End date"/>

            <DatePicker fx:id="endDatePicker"
                        promptText="To"
                        maxWidth="150"/>

            <HBox spacing="8">

                <Button text="Apply"
                        onAction="#onApplyFilter"/>

                <Button text="Clear"
                        onAction="#onClearFilter"/>

            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="statusLabel"
                   text=""
                   wrapText="true"/>

        </VBox>
    </left>

    <center>
        <TableView fx:id="logsTable"
                   prefHeight="390">

            <columns>
                <TableColumn fx:id="logIdColumn"
                             text="ID"
                             prefWidth="50"/>
                <TableColumn fx:id="timestampColumn"
                             text="Timestamp"
                             prefWidth="140"/>
                <TableColumn fx:id="usernameColumn"
                             text="Username"
                             prefWidth="100"/>
                <TableColumn fx:id="actorRoleColumn"
                             text="Role"
                             prefWidth="85"/>
                <TableColumn fx:id="actionTypeColumn"
                             text="Action"
                             prefWidth="120"/>
                <TableColumn fx:id="resultColumn"
                             text="Result"
                             prefWidth="75"/>
                <TableColumn fx:id="fileNameColumn"
                             text="File"
                             prefWidth="120"/>
            </columns>

        </TableView>
    </center>

</BorderPane>
