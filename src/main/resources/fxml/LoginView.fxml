<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      fillWidth="true"
      styleClass="intermediate-root">

      <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
      </padding>

      <VBox spacing="12"
            alignment="CENTER"
            maxWidth="360"
            styleClass="intermediate-panel">

            <Label text="Login"
                   styleClass="intermediate-title"/>

            <TextField fx:id="usernameField"
                       promptText="Username"
                       maxWidth="Infinity"/>

            <PasswordField fx:id="passwordField"
                           promptText="Password"
                           maxWidth="Infinity"/>

            <Label fx:id="errorLabel"
                   text=""
                   maxWidth="Infinity"
                   wrapText="true"
                   styleClass="form-message"/>

            <Button text="Login"
                    maxWidth="Infinity"
                    onAction="#onLoginClicked"/>

      </VBox>

</VBox>
