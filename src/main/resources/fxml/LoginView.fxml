<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      spacing="12"
      alignment="CENTER">

      <Label text="Login"/>

      <VBox spacing="4"
            alignment="CENTER">

            <Label text="Test accounts:"
                  style="-fx-text-fill: gray; -fx-font-size: 11px; -fx-font-weight: bold;"/>

            <Label text="abc / 123 → normal login"
                  style="-fx-text-fill: gray; -fx-font-size: 11px;"/>

            <Label text="teste / 123 → must change password"
                  style="-fx-text-fill: gray; -fx-font-size: 11px;"/>

      </VBox>

      <TextField fx:id="usernameField"
                 promptText="Username"
                 maxWidth="240"/>

      <PasswordField fx:id="passwordField"
                     promptText="Password"
                     maxWidth="240"/>

      <Label fx:id="errorLabel"
             text=""
             maxWidth="240"
             wrapText="true"/>

      <Button text="Login"
              onAction="#onLoginClicked"/>

</VBox>