<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml">

      <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
      </padding>

      <left>
            <VBox spacing="14"
                  prefWidth="145">

                  <Label text="Filters"
                        style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

                  <Label text="Roles"
                        style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 0 0 0;"/>

                  <CheckBox fx:id="userFilterCheckBox"
                              text="User"
                              selected="true"/>

                  <CheckBox fx:id="auditorFilterCheckBox"
                              text="Auditor"
                              selected="true"/>

                  <CheckBox fx:id="adminFilterCheckBox"
                              text="Admin"
                              selected="true"/>

                  <Label text="Status"
                        style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 0 0 0;"/>

                  <CheckBox fx:id="activeFilterCheckBox"
                              text="Active"
                              selected="true"/>

                  <CheckBox fx:id="disabledFilterCheckBox"
                              text="Disabled"
                              selected="true"/>

                  <Separator/>

                  <Label text="Search"/>

                  <TextField fx:id="searchField"
                              promptText="Username"
                              maxWidth="130"/>

                  <Region VBox.vgrow="ALWAYS"/>

                  <Button text="Back"
                        onAction="#onBackClicked"
                        maxWidth="130"/>

            </VBox>
      </left>

      <center>
            <VBox spacing="12">

                  <HBox spacing="12"
                        alignment="CENTER_LEFT">

                        <Label text="Accounts"/>

                        <Label fx:id="accountCountLabel"
                               text=""/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="+ Create Account"
                                onAction="#onCreateAccount"/>

                  </HBox>

                  <ScrollPane fitToWidth="true"
                              fitToHeight="true"
                              hbarPolicy="NEVER">

                        <content>
                              <FlowPane fx:id="accountsContainer"
                                        hgap="10"
                                        vgap="10"
                                        prefWrapLength="320"/>
                        </content>

                  </ScrollPane>

                  <Label fx:id="resultLabel"
                         text=""
                         wrapText="true"/>

            </VBox>
      </center>

</BorderPane>
