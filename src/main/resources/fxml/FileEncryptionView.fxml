<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      spacing="16"
      alignment="CENTER"
      fillWidth="true"
      styleClass="file-workspace">

        <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <HBox spacing="8"
              alignment="CENTER_LEFT"
              maxWidth="Infinity">

                <Button text="Encrypt File"
                        disable="true"/>

                <Button text="Decrypt File"
                        onAction="#onDecryptSelected"/>
        </HBox>

        <VBox spacing="14"
              alignment="CENTER"
              maxWidth="Infinity"
              VBox.vgrow="ALWAYS">

                <VBox fx:id="dropArea"
                      alignment="CENTER"
                      spacing="10"
                      minHeight="210"
                      prefHeight="300"
                      maxWidth="Infinity"
                      maxHeight="Infinity"
                      styleClass="file-drop-area"
                      VBox.vgrow="ALWAYS">

                        <Label text="⇧"
                               styleClass="file-drop-icon"/>

                        <Label text="Drop a file here or click to browse"
                               wrapText="true"
                               maxWidth="Infinity"
                               styleClass="file-drop-title"/>

                        <Label text="Any file type supported"
                               wrapText="true"
                               maxWidth="Infinity"
                               styleClass="file-drop-hint"/>
                </VBox>

                <HBox spacing="16"
                      alignment="CENTER_LEFT"
                      maxWidth="Infinity"
                      styleClass="file-details">

                        <Label fx:id="selectedFileLabel"
                               text="Selected file: -"
                               wrapText="true"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>

                        <Label fx:id="sizeLabel"
                               text="Size: -"
                               minWidth="90"/>
                </HBox>
        </VBox>

        <HBox spacing="12"
              alignment="CENTER_LEFT"
              maxWidth="Infinity">

                <Label fx:id="statusLabel"
                       text=""
                       wrapText="true"
                       maxWidth="Infinity"
                       style="-fx-text-fill: #6b7280;"
                       HBox.hgrow="ALWAYS"/>

                <Button fx:id="encryptButton"
                        text="Encrypt"
                        disable="true"
                        onAction="#onEncryptClicked"/>

                <Button text="Back"
                        onAction="#onBackClicked"/>
        </HBox>

</VBox>
